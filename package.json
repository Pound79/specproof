{
  "name": "specproof",
  "private": true,
  "version": "0.0.0",
  "description": "Framework-agnostic AI-development quality governance kit: a traceability engine + AI agent skills (SKILL.md standard) + per-framework BDD scaffolds (playwright web, Flutter flutter_gherkin).",
  "type": "module",
  "license": "MIT",
  "author": "Pound79",
  "homepage": "https://github.com/Pound79/specproof",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pound79/specproof.git"
  },
  "workspaces": [
    "packages/*",
    "cli"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && node --test --test-concurrency=1 \"scripts/**/*.test.?(c|m)js\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:versions": "node scripts/check-versions.mjs",
    "release": "bash scripts/release.sh",
    "lint": "biome lint cli/src packages/traceability/src",
    "format": "biome format --write cli/src packages/traceability/src",
    "format:check": "biome format cli/src packages/traceability/src",
    "test:coverage": "npm run test:coverage --workspaces --if-present"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@vitest/coverage-v8": "5.0.2"
  }
}
